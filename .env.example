# Modelo de variáveis de ambiente do MediStock.
# Copie para .env e preencha. O .env real nunca é versionado.

# Caminho do JSON da conta de serviço do Firebase (seção 9 da especificação)
FIREBASE_CREDENTIALS=

# Segredo e expiração do JWT em milissegundos (seção 5)
JWT_SECRET=
JWT_EXPIRATION=

# Origens liberadas no CORS, separadas por vírgula (seção 5)
CORS_ALLOWED_ORIGINS=

# Porta HTTP da aplicação
SERVER_PORT=
